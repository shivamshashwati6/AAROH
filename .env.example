# ==============================================================================
# RELIEF-OS Root Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env before starting the services:
#   cp .env.example .env
#
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL.
# ==============================================================================

# Node Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# Backend API Service (apps/api)
# ------------------------------------------------------------------------------
PORT=4000
API_HOST=localhost
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# PostgreSQL with PostGIS Database Configuration (Supabase or Local)
# ------------------------------------------------------------------------------
# For Supabase: Obtain your connection details from:
#   Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
#
# Note: For Supabase, use the Transaction / Session Pooler (port 6543) or Direct (port 5432).
# SSL is mandatory for Supabase connections (DB_SSL=true).
#
# Option A (Recommended): Full Connection URI
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Option B: Individual connection parameters
DB_HOST=aws-0-[REGION].pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.[YOUR-PROJECT-REF]
DB_PASSWORD=your_supabase_database_password_here
DB_SSL=true

# ------------------------------------------------------------------------------
# Frontend Application (apps/web)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:4000/api
VITE_APP_NAME=RELIEF-OS
VITE_ENABLE_SIMULATED_DATA_BADGE=true

# ------------------------------------------------------------------------------
# AI Service Integration (Phase 2 - Gemini API)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Required for AI extraction, priority scoring explanations,
# and What-If scenario mitigation suggestions during Phase 2)
# Keep empty or set to placeholder during Phase 1.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
